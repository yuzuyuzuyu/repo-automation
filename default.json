{
  "extends": [
    "config:best-practices",
    "customManagers:githubActionsVersions"
  ],
  "osvVulnerabilityAlerts": true,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "minimumReleaseAge": null,
    "enabled": true,
    "automerge": true,
    "rebaseWhen": "behind-base-branch"
  },
  "timezone": "Australia/Melbourne",
  "description": "Shared dependency maintenance policy; repository rules preserve local exceptions.",
  "automergeType": "pr",
  "vulnerabilityAlerts": {
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)(renovate|renovate-config)\\.json5?$/"
      ],
      "matchStrings": [
        "github>yuzuyuzuyu/repo-automation(?::[a-z0-9-]+)?#(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "yuzuyuzuyu/repo-automation",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)(?:\\.github/workflows/.*|actions/.*/action)\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>[^\\s]+)\\n\\s*(?:image|driver-opts):\\s*(?:image=)?[^\\s@]+:(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ]
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "yuzuyuzuyu/repo-automation"
      ],
      "groupName": "Repository automation"
    },
    {
      "matchPackageNames": [
        "docker/buildx",
        "moby/buildkit",
        "tonistiigi/binfmt"
      ],
      "groupName": "Container build tools"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "tonistiigi/binfmt"
      ],
      "versioning": "regex:^qemu-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ]
}
