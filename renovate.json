{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>yuzuyuzuyu/repo-automation:public#v1.0.25"
  ],
  "packageRules": [
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:non-major#v1.0.25"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:major#v1.0.25"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:action-digest-review#v1.0.25"
      ]
    },
    {
      "matchPackageNames": [
        "renovate",
        "ghcr.io/renovatebot/renovate"
      ],
      "groupName": "Renovate engine",
      "schedule": [
        "before 6am on monday"
      ],
      "pinDigests": true
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:automation-updates#v1.0.25"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:age-3-days#v1.0.25"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:age-7-days#v1.0.25"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^actions/security-scan/action\\.yml$/"
      ],
      "matchStrings": [
        "default: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^config/renovate-image\\.json$/"
      ],
      "matchStrings": [
        "\"image\":\\s*\"(?<depName>ghcr\\.io/renovatebot/renovate):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "pip_requirements": {
    "enabled": false
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements-dev\\.txt$/"
    ]
  }
}
